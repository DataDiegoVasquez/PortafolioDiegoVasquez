---
const lang = Astro.currentLocale || 'es';
const CONTENT = {
  es: {
    profession: "Ingeniero de Datos",
    description: "Especializado en construir pipelines estables, optimizar arquitecturas en la nube (GCP/Azure) y transformar grandes volúmenes de datos en decisiones estratégicas.",
    btnProjects: "Ver Portafolio",
    btnContact: "Conóceme más",
    scrollText: "Desliza hacia abajo"
  },
  en: {
    profession: "Data Engineer",
    description: "Specialized in building stable pipelines, optimizing cloud architectures (GCP/Azure), and transforming large data volumes into strategic decisions.",
    btnProjects: "View Portfolio",
    btnContact: "Learn More",
    scrollText: "Scroll down"
  }
};
const t = CONTENT[lang as keyof typeof CONTENT];
---
<section
  class="landing-section min-h-screen w-full text-center md:text-left overflow-hidden relative flex flex-col justify-center"
  data-header-color="white"
>
  <div class="absolute inset-0 z-0">
    <video
      class="video object-cover h-full w-full"
      autoplay
      playsinline
      muted
      loop
      src="/VideoInit.mp4"
    ></video>
    <div class="absolute inset-0 bg-black/60 pointer-events-none"></div>
  </div>

  <div id="Index" class="z-10 relative flex flex-col-reverse lg:flex-row items-center justify-center gap-10 lg:gap-20 px-6 max-w-screen-xl mx-auto w-full pt-32 pb-24">
    
    <div class="flex-1 flex flex-col items-center lg:items-start flex-grow">
      <h1 class="text-white text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-4 animate-fade-in drop-shadow-lg">
        Diego Vasquez
      </h1>
      <p class="text-green-400 font-semibold text-2xl md:text-3xl lg:text-4xl mb-6 drop-shadow-md">
        {t.profession}
      </p>
      <p class="text-gray-200 text-lg md:text-xl max-w-lg text-center lg:text-left text-pretty font-light leading-relaxed mb-10 drop-shadow-md">
        {t.description}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a 
          href="#Projects" 
          class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-black bg-white rounded-full shadow-lg hover:bg-gray-200 transition-all duration-300 hover:scale-105 active:scale-95"
        >
          {t.btnProjects}
        </a>
        <a 
          href="#Profile" 
          class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-white/10 border border-white/20 backdrop-blur-md rounded-full hover:bg-white/30 transition-all duration-300 hover:scale-105 active:scale-95"
        >
          {t.btnContact}
        </a>
      </div>
    </div>

    <div class="flex-1 flex justify-center lg:justify-end animate-fade-in-delayed">
      <img 
        class="w-56 h-56 md:w-72 md:h-72 lg:w-[410px] lg:h-[410px] object-cover object-center rounded-full shadow-[0_10px_30px_rgba(0,0,0,0.5)] border-4 border-white/10 hover:scale-105 hover:border-white/30 transition-all duration-500" 
        src="/Diego.png" 
        alt="Imagen de Perfil de Diego Vasquez" 
      />
    </div>

  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20">
    <a href="#Profile" class="flex flex-col items-center gap-y-2 text-white/70 hover:text-white transition-colors group" aria-label={t.scrollText}>
      <span class="text-xs tracking-widest uppercase font-semibold">{t.scrollText}</span>
      <svg class="w-5 h-5 animate-bounce text-white/70 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 13l-7 7-7-7m14-6l-7 7-7-7"></path>
      </svg>
    </a>
  </div>

</section>

<style>
  /* Animaciones suaves de entrada */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-fade-in-delayed {
    opacity: 0;
    animation: fadeIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }
</style>