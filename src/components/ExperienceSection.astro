---
import ExperienceItem from "./ExperienceItem.astro";
import { EXPERIENCE } from "../data/experience";
const lang = Astro.currentLocale || "es";
const currentExperience = EXPERIENCE[lang as keyof typeof EXPERIENCE];
const sectionTitle = lang === "en" ? "Work Experience" : "Experiencia Laboral";
---

<section
  class="landing-section [background:radial-gradient(125%_125%_at_50%_10%,#000_20%,#FF8A24_100%)] min-h-screen w-full text-center overflow-hidden relative pb-24"
  data-header-color="white"
>
  <div class="z-30 relative h-full flex flex-col">
    <header>
      <h2
        id="Experience"
        class="text-white text-4xl font-bold mb-12 pt-32 flex flex-col gap-x-3 items-center"
      >
        {sectionTitle}
      </h2>
    </header>

    <div class="px-4 max-w-3xl mx-auto text-left w-full">
      <ol class="relative border-s border-gray-500/50 ml-3">
        {
          currentExperience.map((experience) => (
            <li class="mb-10 ms-6">
              <ExperienceItem {...experience} lang={lang}/>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
