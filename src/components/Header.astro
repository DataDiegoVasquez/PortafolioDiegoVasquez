---
// 1. Lógica de Internacionalización (i18n)
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
import Logo from "./Logo.astro";
// Generar la URL contraria (Si estoy en /en/ paso a /, y viceversa)
const switchUrl = isEnglish 
  ? currentPath.replace(/^\/en/, '') || '/' 
  : '/en' + currentPath.replace(/\/$/, ''); // Limpia las barras finales

// 2. Diccionario de navegación según el idioma
const navItems = isEnglish ? [
  { name: "Home", url: "#Index" },
  { name: "Profile", url: "#Profile" },
  { name: "Experience", url: "#Experience" },
  { name: "Portfolio", url: "#Projects" },
  { name: "Achievements", url: "#Achievements" }
] : [
  { name: "Inicio", url: "#Index" },
  { name: "Perfil", url: "#Profile" },
  { name: "Experiencia", url: "#Experience" },
  { name: "Portafolio", url: "#Projects" },
  { name: "Logros", url: "#Achievements" }
];
---

<header id="landing-header" class="fixed top-0 left-0 w-full z-50 flex items-center justify-between px-6 py-4 transition-colors duration-500">
  <Logo />
  <div class="flex-grow basis-0">
    <a href={isEnglish ? "/en/" : "/"} class="font-bold text-lg tracking-wide hover:scale-105 transition-transform inline-block">
      Diego Vasquez
    </a>
  </div>

  <nav class="hidden md:flex">
    <ul class="flex items-center text-sm font-medium gap-x-8 px-6 py-2.5 rounded-full bg-gray-500/10 backdrop-blur-md shadow-sm border border-gray-500/20">
      {navItems.map((item) => (
        <li>
          <a href={item.url} class="hover:text-blue-500 transition-colors">
            {item.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="flex flex-grow basis-0 justify-end items-center">
    <a 
      href={switchUrl}
      class="px-3 py-1.5 text-xs font-bold border-2 border-current rounded-lg hover:bg-current hover:text-white dark:hover:text-black transition-all duration-300"
      aria-label="Cambiar idioma"
      title={isEnglish ? "Cambiar a Español" : "Switch to English"}
    >
      {isEnglish ? 'ES' : 'EN'}
    </a>
  </div>
</header>

<script>
  // 3. Script del Observador Corregido
  const header = document.getElementById("landing-header");
  const sections = document.querySelectorAll(".landing-section");

  // Configuración optimizada para secciones largas (Experiencia, Proyectos, etc.)
  const observerOptions = {
    root: null,
    rootMargin: "-80px 0px -80px 0px", // Detecta exactamente el área del Header
    threshold: 0.05 // Se activa inmediatamente apenas entra el 5% de la sección
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const color = entry.target.getAttribute("data-header-color");
        
        if (color === "white") {
          header?.classList.add("text-white");
          header?.classList.remove("text-black");
        } else {
          header?.classList.add("text-black");
          header?.classList.remove("text-white");
        }
      }
    });
  }, observerOptions);

  // Vigilar todas las secciones
  sections.forEach((section) => observer.observe(section));
</script>