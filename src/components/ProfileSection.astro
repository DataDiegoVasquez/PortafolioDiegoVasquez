---
// En la parte superior de ProfileSection.astro
const TECHNOLOGIES = [
  { name: "GCP", icon: "/icons/GCP.svg", alt: "Logo Google Cloud Platform" },
  { name: "Azure", icon: "/icons/Azure.svg", alt: "Logo Azure" },
  { name: "Git - Github", icon: "/icons/git.svg", alt: "Logo GIT" },
  { name: "BD", icon: "/icons/Database.svg", alt: "Logo databases" },
  { name: "Python", icon: "/icons/Python.svg", alt: "Logo Python" },
  { name: "Databricks", icon: "/icons/Databricks.svg", alt: "Logo Databricks" },
];
---

<section
  class="landing-section h-screen w-screen overflow-hidden relative"
  data-header-color="black"
>
  <div
    class="absolute inset-0 z-[-2] h-screen w-screen bg-white bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:6rem_4rem]"
  >
    <div
      class="absolute bottom-0 left-0 right-0 top-0 bg-[radial-gradient(circle_800px_at_100%_200px,#e77d22,transparent)]"
    >
    </div>
  </div>
  <div
    class="z-30 relative h-full w-full flex flex-col items-center justify-center py-44"
  >
    <header class="text-center">
      <h2
        id="Profile"
        class="text-black text-5xl font-bold flex justify-center flex-row gap-x-4 pb-10"
      >
        Hola, Soy Diego Vasquez
      </h2>
    </header>

    <div
      class="flex flex-row justify-center items-start gap-x-16 max-w-2xl mx-auto"
    >
      <!-- Left Container with Text and List -->
      <div
        class="text-black text-xl opacity-80 text-justify text-align-last-auto text-wrap"
      >
        <p>
          + de 6 años de Experiencia en lenguajes de programacion como <strong
            >Python</strong
          >
          y <strong>SQL</strong>, conocimiento robusto de bases de datos
          relacionales y no relacionales, familiaridad con tecnologías en la
          nube para el procesamiento de datos en tiempo real.
        </p>
        <p>
          Amplio conocimiento en manejo de herramientas ETL, modelado de datos y
          diseño de esquemas, con conocimiento de Ciencia de Datos,
          instrucciones de procesamiento, libros de códigos y datos procesados.
        </p>
        <ul class="list-inline social-buttons flex">
          <li class="list-inline-item mr-4">
            <a
              target="_blank"
              href="https://twitter.com/"
              aria-label="Visitar el perfil de Instagram de Diego Vasquez"
            >
              <img
                class="w-6 h-6"
                title="Instagram"
                src="/icons/instagram_black.png"
                alt="Logo de Instagram"
              />
            </a>
          </li>
          <li class="list-inline-item mr-4">
            <a
              target="_blank"
              href="https://github.com/DataDiegoVasquez"
              aria-label="Visitar el perfil de GitHub de Diego Vasquez"
            >
              <img
                class="w-6 h-6"
                title="GitHub"
                src="/icons/github_black.png"
                alt="Logo de GitHub"
              />
            </a>
          </li>
          <li class="list-inline-item mr-4">
            <a
              target="_blank"
              href="https://www.linkedin.com/in/diegofedericovasquezromero"
              aria-label="Visitar el perfil de LinkedIn de Diego Vasquez"
            >
              <img
                class="w-6 h-6"
                title="LinkedIn"
                src="/icons/linkedin_black.png"
                alt="Logo de LinkedIn"
              />
            </a>
          </li>
          <li class="icon-container">
            <a href="#">
              <img
                class="w-6 h-6"
                title="Chart Line"
                src="/icons/chart_black.png"
                alt="Logo de Chart Line"
              />
            </a>
          </li>
        </ul>
      </div>
      <!-- Right Container for Technologies -->
      <div class="flex flex-col items-center text-center">
        <h3 class="text-4xl font-semibold">Tecnologias</h3>
        <ul class="grid grid-cols-1 gap-10 sm:grid-cols-2 my-14">
          {
            TECHNOLOGIES.map((tech) => (
              <li class="flex items-center justify-center">
                <p class="flex items-center gap-2 dark:text-gray-400 text-gray-800 text-xl font-medium hover:text-blue-500 transition-colors">
                  {tech.name}
                  <img
                    class="w-6 h-6"
                    title={tech.name}
                    src={tech.icon}
                    alt={tech.alt}
                  />
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
