---
interface Props {
  title: string;
  description: string;
  link?: string;
  date: string;
  tech?: string[];
  lang?: string;
}

const { title, description, link, date, tech, lang = 'es' } = Astro.props;
const buttonText = lang === 'en' ? 'Employment Verification ...' : 'Certificado Laboral ...';

// Pequeña lógica para saber si es el trabajo actual y darle el color/animación especial
const isCurrentJob = date.toLowerCase().includes("actualidad");
---

<div class="p-4 rounded-xl transition-all duration-300 hover:bg-white/5 hover:shadow-lg hover:-translate-y-1 border border-transparent hover:border-white/10 relative">
  
  <div class={`absolute w-3 h-3 rounded-full mt-1.5 -start-[1.65rem] border ${isCurrentJob ? 'bg-blue-500 border-blue-900 shadow-[0_0_10px_rgba(59,130,246,0.8)] animate-pulse' : 'bg-gray-300 border-white'}`}></div>
  
  <time class="mb-1 text-sm font-normal leading-none text-gray-300/80">{date}</time>
  <h3 class="text-xl font-bold text-white mt-2">{title}</h3>
  <p class="mt-3 mb-4 text-base font-normal text-gray-300 text-pretty">{description}</p>
  
  {tech && (
    <ul class="flex flex-wrap gap-2 mt-4 mb-4">
      {tech.map((t) => (
        <li class="bg-gray-800/80 text-blue-200 text-xs font-medium px-3 py-1 rounded-full border border-blue-900/50 shadow-sm">
          {t}
        </li>
      ))}
    </ul>
  )}

  {link && (
    <a href={link} class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-white/10 border border-white/20 rounded-lg hover:bg-white/20 hover:text-white transition-colors focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-700">
      {buttonText}
      <svg class="w-3 h-3 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
      </svg>
    </a>
  )}
</div>